DATABASE_URL=postgresql+asyncpg://app_gestao_financeira_user:<password>@localhost/app_gestao_financeira

# Opcional. Atributo "Secure" do cookie de sessão — True por omissão (o
# correcto: o cookie só viaja em HTTPS). Definir como false APENAS para
# testar a aplicação noutro dispositivo (um telemóvel) pelo endereço de
# rede da máquina, que é HTTP simples. NUNCA em produção.
# COOKIE_SECURE=false

# Obrigatório para a integração de Open Banking (ver
# app/services/enable_banking.py). ID da aplicação registada no painel da
# Enable Banking (enablebanking.com/cp), e caminho para o ficheiro .pem da
# respectiva chave privada, descarregado nesse registo — nunca commitado.
ENABLE_BANKING_APPLICATION_ID=<id-da-aplicacao>
ENABLE_BANKING_PRIVATE_KEY_PATH=<id-da-aplicacao>.pem
